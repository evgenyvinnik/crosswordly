{
  "name": "crosswordly",
  "version": "1.0.261031.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:sitemap && tsc -b && vite build",
    "preview": "vite preview",
    "predeploy": "cross-env GITHUB_PAGES=true npm run build",
    "deploy": "gh-pages -d dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:e2e": "playwright test",
    "generate:sitemap": "tsx scripts/generateSitemap.ts",
    "build:ios": "tsc -b && cross-env CAPACITOR_BUILD=true vite build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run build:ios && cap run ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@fontsource/kanit": "^5.3.0",
    "@fontsource/karla": "^5.3.0",
    "@react-spring/web": "^10.1.2",
    "canvas-confetti": "^1.9.4",
    "html2canvas-pro": "2.6.0",
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-ga4": "^3.0.1",
    "react-i18next": "^17.1.11",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/serviceworker": "^0.0.203",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
